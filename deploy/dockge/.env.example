# Dockge .env for the brindex stack. Holds secrets: keep the stack directory readable only by root
# and the deploy user, and never commit the filled-in copy.

# Releases to run (ghcr.io/marcosjunqueira/<repo>:<version>). Pin exact versions; roll back by
# setting the previous one and redeploying the stack.
BRINDEX_API_VERSION=1.0.0
BRINDEX_ADMIN_VERSION=1.0.0
BRINDEX_INGEST_VERSION=1.0.0

# Host user that owns the data dir (`id -u` / `id -g`). Every container that touches it runs as it.
BRINDEX_UID=1000
BRINDEX_GID=1000
# Host directory with brindex.sqlite and accounts.sqlite. Relative paths are relative to the stack
# directory. Back it up (see docs/GO_LIVE.md).
BRINDEX_DATA_DIR=./data

# Public hostnames (Cloudflare-proxied DNS records pointing at this server).
API_HOST=
BILLING_HOST=

# brindex-admin. ADMIN_PASSWORD: at least 16 characters.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Stripe. Leave STRIPE_SECRET_KEY blank to run with admin-issued keys only. A live key (sk_live_...)
# is refused unless STRIPE_LIVE_MODE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_LOGIN_URL=
STRIPE_LIVE_MODE=false
