# Copy to .env next to docker-compose.yml (chmod 600, never commit). brindex-admin's own secrets
# (ADMIN_PASSWORD, STRIPE_*) go in brindex-admin.env, not here.

# Releases to run (ghcr.io/marcosjunqueira/<repo>:<version>). Pin exact versions; roll back by
# setting the previous one and running `docker compose up -d`.
BRINDEX_API_VERSION=1.0.0
BRINDEX_ADMIN_VERSION=1.0.0
BRINDEX_INGEST_VERSION=1.0.0

# Host user that owns ./data (`id -u` / `id -g`). Every container that touches ./data runs as it.
BRINDEX_UID=1000
BRINDEX_GID=1000

API_HOST=api.example.com
BILLING_HOST=billing.example.com

# Traefik: Let's Encrypt account email and Cloudflare token (Zone > DNS > Edit, this zone only).
ACME_EMAIL=you@example.com
CF_DNS_API_TOKEN=
