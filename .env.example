# Copy this file to .env and adjust values for your machine. .env itself is gitignored — never
# commit it. See CLAUDE.md and .specs/New/SPEC_READ_API.md for what these control.

# Path to the SQLite file brindex-ingest writes. Must already have the series/points tables —
# this API never creates them and fails fast at startup if they're missing.
# Default when unset: brindex.sqlite (relative to the working directory).
BRINDEX_DB_PATH=/path/to/brindex.sqlite

# TCP port to listen on. Default when unset: 8080.
PORT=8080

# Comma-separated list of origins (scheme + host + port, e.g. http://localhost:5174) allowed to
# call this API from a browser. Unset/empty means CORS is off entirely — no
# Access-Control-Allow-Origin header is sent, matching today's behavior.
# CORS_ALLOWED_ORIGINS=http://localhost:5174

# Maximum number of points a single /series/{...code}/points response may carry. A range with more
# points is rejected with 400 (never silently truncated). Default when unset: 100000.
# POINTS_MAX_ROWS=100000

# --- API keys (optional; see .specs/New/SPEC_API_ACCESS.md) ---

# When true, every /series... request needs "Authorization: Bearer <key>" with an active key.
# Default when unset: false (no auth, private network only).
# REQUIRE_API_KEY=true

# Accounts database written by the separate admin/billing service. Read-only here; must already
# exist with an `accounts` table when REQUIRE_API_KEY=true. Default when unset: accounts.sqlite.
# ACCOUNTS_DB_PATH=/path/to/accounts.sqlite

# Requests per minute allowed per API key. Default when unset: 60.
# RATE_LIMIT_PER_MINUTE=60
